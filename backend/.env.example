# Copy this to .env and fill in your values for local development.
# On Render, set these as environment variables in the dashboard.

FYERS_CLIENT_ID=your_fyers_client_id_here
FYERS_SECRET_KEY=your_fyers_secret_key_here
FYERS_REDIRECT_URI=https://your-render-service.onrender.com/api/fyers/callback

# Comma-separated list of allowed frontend origins (your Vercel URL)
CORS_ORIGINS=https://your-app.vercel.app
